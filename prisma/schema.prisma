// BillNotify Nepal - Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum UtilityType {
  ELECTRICITY
  WATER
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserProfile {
  id           String           @id @default(cuid())
  clerkId      String           @unique
  email        String           @unique
  name         String?
  plan         Plan             @default(FREE)
  emailEnabled Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  accounts           UtilityAccount[]
  notifications      NotificationLog[]
  paymentSubmissions PaymentSubmission[]
}

model UtilityAccount {
  id              String           @id @default(cuid())
  userId          String
  user            UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  utilityType     UtilityType      @default(ELECTRICITY)
  providerName    String           @default("NEA")
  customerName    String?
  neaLocationCode String
  scNo            String
  consumerId      String
  emailOverride   String?
  active          Boolean          @default(true)
  lastStatus      String?
  lastAmount      Float?
  lastBillMonth   String?
  lastCheckedAt   DateTime?
  lastNotifiedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notifications   NotificationLog[]
  billHistory     BillHistory[]

  @@unique([userId, neaLocationCode, scNo, consumerId])
}

model NotificationLog {
  id        String         @id @default(cuid())
  userId    String
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   UtilityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     String
  amount    Float
  billMonth String
  status    String
  sentAt    DateTime       @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      Plan     @default(FREE)
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillHistory {
  id          String         @id @default(cuid())
  accountId   String
  account     UtilityAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Float
  billMonth   String         // Format: "2024-01" or "January 2024"
  billDate    DateTime?      // Optional: specific bill date
  status      String?        // e.g., "PAID", "UNPAID", "OVERDUE"
  detectedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Ensure no duplicate bills for same account + month
  @@unique([accountId, billMonth])
  @@index([accountId])
  @@index([billMonth])
}

model PaymentSubmission {
  id         String                  @id @default(cuid())
  userId     String
  user       UserProfile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofImage String
  status     PaymentSubmissionStatus @default(PENDING)
  submittedAt DateTime               @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
}
